{
  "name": "@berrydev-ai/plugin-llm-wiki",
  "version": "0.1.2",
  "type": "module",
  "description": "Local-file LLM Wiki plugin for source ingestion, wiki browsing, query, lint, and maintenance workflows. Maintained fork of @paperclipai/plugin-llm-wiki.",
  "license": "MIT",
  "homepage": "https://github.com/berrydev-ai/paperclip-plugin-llm-wiki#readme",
  "bugs": {
    "url": "https://github.com/berrydev-ai/paperclip-plugin-llm-wiki/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/berrydev-ai/paperclip-plugin-llm-wiki.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "agents",
    "dist",
    "migrations",
    "skills",
    "templates",
    "README.md"
  ],
  "scripts": {
    "build": "node ./esbuild.config.mjs",
    "build:rollup": "rollup -c",
    "dev": "node ./esbuild.config.mjs --watch",
    "dev:ui": "paperclip-plugin-dev-server --root . --ui-dir dist/ui --port 4177",
    "prepack": "npm run build",
    "test": "vitest run --config ./vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js",
    "ui": "./dist/ui/"
  },
  "keywords": [
    "paperclip",
    "plugin",
    "automation",
    "wiki",
    "knowledge"
  ],
  "author": "Berry Development",
  "devDependencies": {
    "@paperclipai/plugin-sdk": "2026.817.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "esbuild": "^0.28.1",
    "jsdom": "^28.0.0",
    "react-dom": "^19.2.8",
    "rollup": "^4.62.4",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
